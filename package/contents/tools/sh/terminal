#!/usr/bin/env bash
# Usage: terminal <terminal-app> <work-dir> <command>
# Remains alive until terminal-job reports completion, including terminals that
# delegate to an existing server and exit immediately. Never infer success.
set -u
term=${1:-}; workdir=${2:-}; cmd=${3:-}
[[ -n "$workdir" && "$workdir" != "~" ]] || workdir=$HOME
# ── Detect terminal if not specified ─────────────────────────────────────────
if [ -z "$term" ]; then
    kde_term=$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)
    [ -z "$kde_term" ] && kde_term=$(kreadconfig5 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)
    xdg_term=$(xdg-mime query default x-scheme-handler/terminal 2>/dev/null | sed -E 's/\.desktop$//; s/^.*\.//')
    for candidate in "${TERMINAL:-}" "$kde_term" "$xdg_term" "${TERM_PROGRAM:-}" konsole kitty alacritty foot wezterm ghostty xterm; do
        [ -n "$candidate" ] && command -v "$candidate" &>/dev/null && term="$candidate" && break
    done
    [ -z "$term" ] && term="xterm"
fi


command -v "$term" >/dev/null || { echo "Terminal unavailable: $term" >&2; exit 127; }
user_shell=$(getent passwd "$USER" 2>/dev/null | cut -d: -f7)
user_shell=${user_shell:-${SHELL:-/bin/sh}}
job_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/nixdatifier-command.XXXXXXXX") || exit 1
trap 'rm -rf -- "$job_dir"' EXIT
worker="$(dirname "$(realpath "$0")")/terminal-job"
args=(bash "$worker" "$job_dir" "$workdir" "$user_shell" "$cmd")
case "${term##*/}" in
    konsole|konsole-nkde) "$term" --workdir "$workdir" -e "${args[@]}" 9>&- & ;;
    kitty) "$term" --directory "$workdir" "${args[@]}" 9>&- & ;;
    foot) "$term" --working-directory="$workdir" "${args[@]}" 9>&- & ;;
    wezterm) "$term" start --cwd "$workdir" -- "${args[@]}" 9>&- & ;;
    alacritty) "$term" --working-directory "$workdir" -e "${args[@]}" 9>&- & ;;
    ghostty) "$term" --working-directory="$workdir" -e "${args[@]}" 9>&- & ;;
    gnome-terminal|ptyxis) "$term" --working-directory="$workdir" -- "${args[@]}" 9>&- & ;;
    *) "$term" -e "${args[@]}" 9>&- & ;;
esac
# Bound only the launch handshake, never the running user's command.
for ((attempt=0; attempt<30; attempt++)); do
    [[ -f "$job_dir/pid" || -f "$job_dir/done" ]] && break
    sleep 1
done
[[ -f "$job_dir/pid" || -f "$job_dir/done" ]] || { echo "Terminal did not start the command" >&2; exit 1; }
while [[ ! -f "$job_dir/done" ]]; do
    job_pid=$(cat "$job_dir/pid")
    kill -0 "$job_pid" 2>/dev/null || { echo "Terminal command ended without a result" >&2; exit 1; }
    sleep 1
done
job_code=$(cat "$job_dir/done")
[[ "$job_code" =~ ^[0-9]+$ ]] || exit 1
exit "$job_code"
