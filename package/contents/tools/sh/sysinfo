#!/usr/bin/env bash
# Emits: hostname --- nixos-version --- uptime --- last-profile-activation
cat /etc/hostname 2>/dev/null || hostname 2>/dev/null
echo '---'
cat /run/current-system/nixos-version 2>/dev/null
echo '---'
awk '{s=$1; h=int(s/3600); m=int((s%3600)/60); printf "%dh %dm", h, m}' /proc/uptime 2>/dev/null
echo '---'
stat --format='%y' /nix/var/nix/profiles/system 2>/dev/null | cut -d'.' -f1
exit 0
