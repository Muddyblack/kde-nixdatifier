#!/usr/bin/env bash
# Usage: store-usage <store-path>
# Explains what keeps a /nix/store/... path from being garbage collected.
# Emits four \x1e-separated fields:
#   [0] GC roots that (transitively) point at the path, one per line
#   [1] direct referrers within the store, one per line
#   [2] closure size in bytes ("" if the path no longer exists)
#   [3] "1" if the path still exists on disk, "0" otherwise
set -u
export PATH="$PATH:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin"

# --roots/--referrers walk the Nix DB and can be slow on a large store — keep
# them from competing with the desktop for CPU/disk, same as diskusage.
lowprio() {
    if command -v ionice >/dev/null 2>&1; then
        nice -n 19 ionice -c 3 "$@"
    else
        nice -n 19 "$@"
    fi
}

raw="${1:-}"
[ -n "$raw" ] || { echo "ERROR: missing store path" >&2; exit 2; }

path=$(realpath -m "$raw" 2>/dev/null) || path="$raw"
[[ "$path" =~ ^/nix/store/[0-9a-z]{32}- ]] || { echo "ERROR: not a store path" >&2; exit 2; }

if [ -e "$path" ]; then
    exists=1
else
    exists=0
fi

if [ "$exists" = 1 ]; then
    lowprio nix-store --query --roots "$path" 2>/dev/null
fi
printf '\x1e'

if [ "$exists" = 1 ]; then
    lowprio nix-store --query --referrers "$path" 2>/dev/null
fi
printf '\x1e'

if [ "$exists" = 1 ]; then
    nix path-info -S "$path" 2>/dev/null | awk '{print $NF}'
fi
printf '\x1e'

printf '%s' "$exists"
exit 0
