#!/usr/bin/env bash
# Usage: diskusage
# Emits three lines separated by \x1e:
#   [0] Total /nix/store size on disk (bytes)
#   [1] Reclaimable by garbage collection (bytes); "" if not computable
#   [2] /nix filesystem free space (bytes)
export PATH="$PATH:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/root/.nix-profile/bin"

# Both measurements below are heavy: `du` stats every inode in the store and
# `nix-store --gc --print-dead` walks the whole GC graph. The widget already
# runs this on demand rather than on a timer, but when it does run it must not
# compete with the desktop for CPU or disk — so everything here goes through
# the lowest scheduling and I/O priority we can get.
lowprio() {
    if command -v ionice >/dev/null 2>&1; then
        nice -n 19 ionice -c 3 "$@"
    else
        nice -n 19 "$@"
    fi
}

# Total store size — walks the filesystem, so keep it out of the desktop's way
lowprio du -sb /nix/store 2>/dev/null | awk '{print $1}'
printf '\x1e'

# Reclaimable: sum the NAR sizes of every dead path, read from the Nix
# database. `nix-collect-garbage --dry-run` cannot be used for this — current
# Nix only prints "N store paths would be deleted", with no byte total, so the
# old parser here came back empty (or read the path count as bytes).
# JSON mode rather than `-s`: --print-dead also lists entries that are not
# valid store objects (stale locks and the like), which abort `-s` mid-list
# but come back as null in JSON. --json-format is required by Nix ≥ 2.34 and
# unknown to older releases, hence the retry without it.
dead_list=$(mktemp -t nixdatifier-dead.XXXXXX) && {
    trap 'rm -f "$dead_list"' EXIT
    lowprio nix-store --gc --print-dead 2>/dev/null > "$dead_list"
    if [ -s "$dead_list" ]; then
        { nix --extra-experimental-features nix-command path-info --stdin --json --json-format 1 < "$dead_list" 2>/dev/null \
            || nix --extra-experimental-features nix-command path-info --stdin --json < "$dead_list" 2>/dev/null; } \
          | grep -o '"narSize":[0-9]*' \
          | awk -F: '{ s += $2 } END { if (NR) printf "%.0f", s }'
    else
        printf '0'
    fi
}
printf '\x1e'

# Free space on the filesystem holding /nix
df -B1 --output=avail /nix 2>/dev/null | tail -n1 | tr -d ' '
exit 0
