#!/usr/bin/env bash
# Usage: secrets <deployed_path> <source_path> <flake_dir>
# All args optional. flake_dir is used to auto-detect source_path when empty.
#
# Output: two blocks separated by "===".
#
# Deployed block lines:
#   1  resolved path (or empty)
#   2  exists|missing
#   3  last-modified (stat)
#   4  ---
#   5  fresh|stale
#   6  file-count
#   7+ secret names (one per line, prefixed "name:")
#
# Source block lines:
#   1  resolved path (or empty)
#   2  exists|missing
#   3  last-modified (from sops metadata if present, else stat)
#   4  ---
#   5  encrypted|plain|directory|unknown
#   6  sops-version (or empty)
#   7  recipient-count (or empty)
#   8  encryption-type: age|pgp|mixed|unknown
#   9+ secret names (one per line, prefixed "name:")

probe_deployed() {
    local path="$1"

    if [ -z "$path" ]; then
        for candidate in /run/secrets /run/agenix.d; do
            if [ -e "$candidate" ]; then
                path="$candidate"
                break
            fi
        done
    fi

    if [ -z "$path" ]; then
        printf '\nmissing\n\n---\n\n0\n'
        return
    fi

    echo "$path"

    if [ ! -e "$path" ]; then
        printf 'missing\n\n---\n\nstale\n0\n'
        return
    fi

    echo "exists"
    stat --format='%y' "$path" 2>/dev/null | cut -d'.' -f1
    echo "---"
    if find "$path" -maxdepth 0 -newer /run/current-system 2>/dev/null | grep -q .; then
        echo 'fresh'
    else
        echo 'stale'
    fi

    if [ -d "$path" ]; then
        local count
        count=$(find "$path" -maxdepth 1 -not -path "$path" | wc -l 2>/dev/null || echo 0)
        echo "$count"
        find "$path" -maxdepth 1 -not -path "$path" -printf 'name:%f\n' 2>/dev/null | sort
    else
        echo "1"
        echo "name:$(basename "$path")"
    fi
}

probe_source() {
    local path="$1"
    local flake_dir="$2"

    # Auto-detect: scan flake_dir for SOPS-encrypted YAML/JSON files (depth ≤ 4)
    if [ -z "$path" ] && [ -n "$flake_dir" ] && [ -d "$flake_dir" ]; then
        path=$(find "$flake_dir" -maxdepth 4 -type f \
            \( -name '*.yaml' -o -name '*.yml' -o -name '*.json' \) \
            ! -path '*/.git/*' ! -path '*/node_modules/*' ! -path '*/.direnv/*' \
            ! -name '*.example' ! -name '*.lock' \
            -print 2>/dev/null \
            | while read -r f; do
                if grep -qE '^sops:' "$f" 2>/dev/null; then
                    echo "$f"
                    break
                fi
            done | head -1)
    fi

    if [ -z "$path" ]; then
        printf '\nmissing\n\n---\n\n\n\nunknown\n'
        return
    fi

    echo "$path"

    if [ ! -e "$path" ]; then
        printf 'missing\n\n---\n\n\n\nunknown\n'
        return
    fi

    echo "exists"

    if [ -d "$path" ]; then
        stat --format='%y' "$path" 2>/dev/null | cut -d'.' -f1
        echo "---"
        echo "directory"
        echo ""
        echo ""
        echo "unknown"
        return
    fi

    # Try to pull lastmodified from SOPS metadata
    local sops_mtime
    sops_mtime=$(grep -E '^\s+lastmodified:' "$path" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/' | sed 's/T/ /; s/Z//')
    if [ -n "$sops_mtime" ]; then
        echo "$sops_mtime"
    else
        stat --format='%y' "$path" 2>/dev/null | cut -d'.' -f1
    fi
    echo "---"

    # Detect encryption
    if grep -qE '^\s*(sops:|age:|pgp:)' "$path" 2>/dev/null; then
        echo "encrypted"
        # SOPS version
        local sops_ver
        sops_ver=$(grep -E '^\s+version:' "$path" 2>/dev/null | head -1 | awk '{print $2}')
        echo "${sops_ver}"
        # Recipient count and type
        local age_count pgp_count
        age_count=$(grep -cE '^\s+- recipient: age1' "$path" 2>/dev/null); age_count=${age_count:-0}
        pgp_count=$(grep -cE '^\s+- created_at:' "$path" 2>/dev/null);    pgp_count=${pgp_count:-0}
        local total=$(( ${age_count} + ${pgp_count} ))
        echo "$total"
        if [ "$age_count" -gt 0 ] && [ "$pgp_count" -gt 0 ]; then
            echo "mixed"
        elif [ "$age_count" -gt 0 ]; then
            echo "age"
        elif [ "$pgp_count" -gt 0 ]; then
            echo "pgp"
        else
            echo "unknown"
        fi
        # Secret keys: top-level keys that are not "sops:"
        grep -E '^[a-zA-Z0-9_-]+:' "$path" 2>/dev/null \
            | grep -v '^sops:' \
            | cut -d: -f1 \
            | sort \
            | sed 's/^/name:/'
    else
        echo "plain"
        echo ""
        echo ""
        echo "unknown"
    fi
}

probe_deployed "$1"
echo "==="
probe_source "$2" "$3"

exit 0
