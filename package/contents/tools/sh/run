#!/usr/bin/env bash
# Cross-host operation ownership and reusable expensive read results.
set -euo pipefail
umask 077
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/nixdatifier"
mkdir -p "$cache_root"
mode="${1:?missing mode}"; shift
case "$mode" in
    mutate)
        [[ "${1:-}" == -- ]] && shift
        exec 9>"$cache_root/system-operation.lock"
        flock -n 9 || { echo 'Another Nixdatifier system operation is already running.' >&2; exit 75; }
        set +e
        "$@"
        result=$?
        # Cached measurements no longer describe the post-operation store.
        rm -f "$cache_root"/disk-*.result
        exit "$result"
        ;;
    cached)
        scope="${1:?}"; ttl="${2:?}"; shift 2
        [[ "${1:-}" == -- ]] && shift
        [[ "$ttl" =~ ^[0-9]+$ ]] || exit 2
        requested=$(date +%s)
        fingerprint=''
        if [[ "$scope" == flake:* && -f "${2:-}/flake.lock" ]]; then
            fingerprint=$(sha256sum "${2}/flake.lock")
        fi
        key=$(printf '%s\0' v1 "$scope" "$fingerprint" "${1##*/}" "${@:2}" | sha256sum | cut -d' ' -f1)
        prefix=probe
        [[ "$scope" == disk ]] && prefix=disk
        result_file="$cache_root/$prefix-$key.result"
        exec 9>"$result_file.lock"
        flock 9
        if [[ -f "$result_file" ]]; then
            stamp=$(stat -c %Y "$result_file")
            now=$(date +%s)
            if (( now-stamp < ttl || stamp >= requested )); then cat "$result_file"; exit 0; fi
        fi
        temp=$(mktemp "$cache_root/.probe.XXXXXXXX")
        trap 'rm -f "$temp"' EXIT
        "$@" >"$temp"
        mv "$temp" "$result_file"
        cat "$result_file"
        # Keys include lock fingerprints, closures, and diff contents, so old
        # entries are never read again. On a miss, drop anything untouched for
        # 30 days: results, their locks (reopened, and so re-dated, on every
        # use), superseded flake caches, and temp files of interrupted writes.
        find "$cache_root" -maxdepth 1 -type f \( -name 'probe-*' -o -name 'disk-*' -o -name 'flake-*' -o -name '.probe.*' -o -name '.state.*' \) -mtime +30 -delete 2>/dev/null || true
        ;;
    *) echo 'Unknown operation mode' >&2; exit 2 ;;
esac
